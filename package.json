{
  "name": "framemodelmaker-web",
  "version": "1.2.0",
  "description": "Browser-based editor, validator, visualizer, and interchange tool for 3D frame analysis models",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "verify": "npm run typecheck && npm test && npm run build && npm run audit",
    "schemas:generate": "node scripts/generate-schemas.cjs",
    "examples:generate": "node scripts/generate-examples.mjs",
    "benchmark": "playwright test --config=playwright.benchmark.config.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "keywords": [
    "structural-engineering",
    "frame-model",
    "three.js",
    "finite-element"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.185.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
